      "wind_speed",
      "lat",
      "lon"
    ],
    "B_process": [
      "precip_mm",
      "surface_runoff_mm",
      "subsurface_runoff_mm",
      "soil_moisture",
      "u10",
      "v10",
      "wind_speed",
      "lat",
      "lon",
      "precip_sum_3d",
      "precip_sum_7d",
      "precip_sum_14d",
      "precip_sum_30d",
