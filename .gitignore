# Component 3 datasets are stored outside this Git repository.
# Keep only documentation files in the repository data directories.
component - 3/data/raw/**
component - 3/data/interim/**
component - 3/data/processed/**
component - 3/data/external/**

!component - 3/data/raw/README.md
!component - 3/data/interim/README.md
!component - 3/data/processed/README.md
!component - 3/data/external/README.md

# Trained Component 3 model binaries are large generated artifacts.
# Store them in Google Drive or another artifact store, not in Git.
component - 3/models/**
!component - 3/models/README.md

# Local Python and notebook state
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Local environment files
.env
.env.*

