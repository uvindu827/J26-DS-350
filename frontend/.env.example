# Copy this file to .env (same folder) and keep the line that matches how you run the app.
# .env is ignored by Git. Restart Expo with `npx expo start -c` after changing it.

# Web browser on this laptop (default)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical phone on the same Wi-Fi (start FastAPI with --host 0.0.0.0):
# EXPO_PUBLIC_API_BASE_URL=http://<laptop IPv4 address>:8000
