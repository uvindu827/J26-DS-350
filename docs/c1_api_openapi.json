            "description": "Forecast issue date YYYY-MM-DD, replay mode: 2022-01-01 to 2025-12-24"
          },
          {
            "name": "benchmark",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include the XGBoost benchmark (expert view)",
              "default": false,
              "title": "Benchmark"
            },
            "description": "Include the XGBoost benchmark (expert view)"
          }
